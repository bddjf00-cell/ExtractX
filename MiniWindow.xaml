<Window x:Class="ExtractX.MiniWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ExtractX" Width="460" Height="560" MinWidth="420" MinHeight="480"
        Icon="Assets/app.ico"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" Topmost="False">
    <Window.Resources>
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#0078D4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#1C8ADB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GhostBtn" TargetType="Button">
            <Setter Property="Background" Value="#1A2433"/>
            <Setter Property="Foreground" Value="#E6EDF5"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#2B3A4F"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#223145"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#0D141D" CornerRadius="16" BorderBrush="#2B3A4F" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Barra mini -->
            <Grid Grid.Row="0" MouseLeftButtonDown="Bar_MouseDown" Background="Transparent" Margin="14,0,8,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Canvas x:Name="BarLogo" Width="24" Height="24" RenderTransformOrigin="0.5,0.5">
                        <Path Data="M4,2 L18,2 L26,16 L18,30 L32,30 L20,16 L32,2 L18,2 Z M12,2 L0,2 L12,16 L0,30 L14,30 L22,16 Z"
                              Fill="#2B9BF4" Stretch="Fill" Width="22" Height="20" Canvas.Left="1" Canvas.Top="2"/>
                    </Canvas>
                    <TextBlock Text="ExtractX" Foreground="White" FontWeight="Bold" FontSize="14" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtMode" Text="· Extracción rápida" Foreground="#8B98AB" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="BtnFull" Content="&#xE2B3;" FontFamily="Segoe MDL2 Assets" Width="38" Height="30" Background="Transparent" Foreground="#8B98AB" BorderThickness="0" Cursor="Hand" ToolTip="Abrir modo completo" Click="BtnFull_Click"/>
                    <Button Content="─" Width="38" Height="30" Background="Transparent" Foreground="#C7D2E0" BorderThickness="0" Cursor="Hand" Click="BtnMin_Click"/>
                    <Button Content="✕" Width="38" Height="30" Background="Transparent" Foreground="#C7D2E0" BorderThickness="0" Cursor="Hand" Click="BtnClose_Click"/>
                </StackPanel>
            </Grid>

            <!-- ===== PANEL EXTRAER ===== -->
            <StackPanel x:Name="PanelExtract" Grid.Row="1" Margin="20,6,20,16">
                <Border Background="#121A24" CornerRadius="12" BorderBrush="#232F40" BorderThickness="1" Padding="16">
                    <StackPanel>
                        <Canvas x:Name="MiniLogo" Width="52" Height="48" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                            <Path Data="M4,2 L18,2 L26,16 L18,30 L32,30 L20,16 L32,2 L18,2 Z M12,2 L0,2 L12,16 L0,30 L14,30 L22,16 Z"
                                  Fill="#2B9BF4" Stretch="Fill" Width="48" Height="44" Canvas.Left="2" Canvas.Top="2"/>
                        </Canvas>
                        <TextBlock x:Name="TxtFileName" Text="archivo.zip" Foreground="White" FontWeight="Bold" FontSize="15" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                        <TextBlock x:Name="TxtFileMeta" Text="—" Foreground="#8B98AB" FontSize="12" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        <TextBlock x:Name="TxtFileContent" Text="—" Foreground="#8B98AB" FontSize="12" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <TextBlock Text="Contraseña (si la pide)" Foreground="#8B98AB" FontSize="11" Margin="0,12,0,0"/>
                <PasswordBox x:Name="PwdBox" Margin="0,6,0,0" Background="#0F1620" Foreground="White" BorderBrush="#2B3A4F" Padding="10,8" FontSize="13"/>
                <ProgressBar x:Name="MiniProgress" Height="8" Minimum="0" Maximum="100" Value="0" Margin="0,14,0,0" Background="#1A2433" Foreground="#0078D4" BorderThickness="0"/>
                <Grid Margin="0,4,0,0">
                    <TextBlock x:Name="TxtStatus" Text="Listo." Foreground="#22C55E" FontSize="12"/>
                    <TextBlock x:Name="TxtPct" Text="" Foreground="#8B98AB" FontSize="12" HorizontalAlignment="Right"/>
                </Grid>
                <Button x:Name="BtnExtractHere" Style="{StaticResource PrimaryBtn}" Content="Extraer aquí" Margin="0,12,0,0" Click="BtnExtractHere_Click"/>
                <Button x:Name="BtnExtractTo" Style="{StaticResource GhostBtn}" Content="Extraer en carpeta..." Margin="0,8,0,0" Click="BtnExtractTo_Click"/>
                <Button x:Name="BtnCancel" Style="{StaticResource GhostBtn}" Content="Cancelar" Margin="0,8,0,0" Visibility="Collapsed" Click="BtnCancel_Click"/>
            </StackPanel>

            <!-- ===== PANEL COMPRIMIR ===== -->
            <StackPanel x:Name="PanelCompress" Grid.Row="1" Margin="20,6,20,16" Visibility="Collapsed">
                <Border Background="#121A24" CornerRadius="12" BorderBrush="#232F40" BorderThickness="1" Padding="16">
                    <StackPanel>
                        <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="30" Foreground="#2B9BF4" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="TxtCompressTitle" Text="2 elementos para comprimir" Foreground="White" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
                <ListView x:Name="CompressList" Height="150" Margin="0,12,0,0" Background="Transparent" BorderThickness="0" Foreground="#E6EDF5" FontSize="12"/>
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="115"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <ComboBox x:Name="MiniFormat" Grid.Column="0" Margin="0,0,8,0" SelectedIndex="0" Foreground="#0B1117">
                        <ComboBoxItem Content="ZIP"/><ComboBoxItem Content="RAR"/><ComboBoxItem Content="7Z"/><ComboBoxItem Content="TAR"/><ComboBoxItem Content="TAR.GZ"/><ComboBoxItem Content="GZ"/>
                    </ComboBox>
                    <ComboBox x:Name="MiniLevel" Grid.Column="1" Margin="0,0,8,0" SelectedIndex="2" Foreground="#0B1117">
                        <ComboBoxItem Content="Sin compresión"/><ComboBoxItem Content="Rápida"/><ComboBoxItem Content="Normal"/><ComboBoxItem Content="Máxima"/>
                    </ComboBox>
                    <PasswordBox x:Name="MiniPwd" Grid.Column="2" Background="#0F1620" Foreground="White" BorderBrush="#2B3A4F" Padding="10,8" FontSize="13"/>
                </Grid>
                <ProgressBar x:Name="CompressProgress" Height="8" Minimum="0" Maximum="100" Value="0" Margin="0,12,0,0" Background="#1A2433" Foreground="#0078D4" BorderThickness="0"/>
                <TextBlock x:Name="TxtCompressStatus" Text="Listo." Foreground="#8B98AB" FontSize="12" Margin="0,4,0,0"/>
                <Button x:Name="BtnCompressGo" Style="{StaticResource PrimaryBtn}" Content="Comprimir" Margin="0,12,0,0" Click="BtnCompressGo_Click"/>
                <Button Style="{StaticResource GhostBtn}" Content="Añadir más archivos..." Margin="0,8,0,0" Click="BtnCompressAdd_Click"/>
            </StackPanel>

            <!-- Overlay de carga -->
            <Grid x:Name="MiniBusy" Grid.Row="1" Visibility="Collapsed" Background="#DD0D141D">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Canvas x:Name="MiniBusyLogo" Width="64" Height="60" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                        <Path Data="M4,2 L18,2 L26,16 L18,30 L32,30 L20,16 L32,2 L18,2 Z M12,2 L0,2 L12,16 L0,30 L14,30 L22,16 Z"
                              Fill="#2B9BF4" Stretch="Fill" Width="60" Height="56" Canvas.Left="2" Canvas.Top="2"/>
                    </Canvas>
                    <TextBlock Text="ExtractX" Foreground="White" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                    <TextBlock x:Name="TxtMiniBusy" Text="Trabajando..." Foreground="#8B98AB" FontSize="12" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    <ProgressBar Width="200" Height="6" Minimum="0" Maximum="100" Margin="0,12,0,0"
                                 Background="#1A2433" Foreground="#0078D4" BorderThickness="0" IsIndeterminate="True"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
