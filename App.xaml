<Application x:Class="ExtractX.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <Color x:Key="Accent">#0078D4</Color>
        <Color x:Key="AccentLight">#2B9BF4</Color>
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Accent}"/>
        <SolidColorBrush x:Key="BgBrush" Color="#0B1117"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#121A24"/>
        <SolidColorBrush x:Key="CardBrush" Color="#161E2A"/>
        <SolidColorBrush x:Key="BorderBrushX" Color="#232F40"/>
        <SolidColorBrush x:Key="TextBrush" Color="#F1F5F9"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#8B98AB"/>
    </Application.Resources>
</Application>
